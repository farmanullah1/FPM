# Line endings for FPM (Windows / WPF).
#
# The object database always stores LF; the working tree is CRLF so Visual
# Studio, the WPF tooling and Notepad all behave normally on Windows.
# Declaring this here means it no longer depends on each clone's
# core.autocrlf setting, and Git stops reporting LF/CRLF conversions.

* text=auto eol=crlf

# Source, project and script files: CRLF in the working tree.
*.cs         text eol=crlf
*.xaml       text eol=crlf
*.axaml      text eol=crlf
*.csproj     text eol=crlf
*.props      text eol=crlf
*.targets    text eol=crlf
*.sln        text eol=crlf
*.slnx       text eol=crlf
*.resx       text eol=crlf
*.manifest   text eol=crlf
*.config     text eol=crlf
*.ps1        text eol=crlf
*.psm1       text eol=crlf
*.cmd        text eol=crlf
*.bat        text eol=crlf
*.json       text eol=crlf
*.xml        text eol=crlf
*.md         text eol=crlf
*.txt        text eol=crlf
*.yml        text eol=crlf
*.yaml       text eol=crlf
*.gitignore  text eol=crlf
.gitignore   text eol=crlf
.gitattributes text eol=crlf

# Shell scripts stay LF so they keep working in Git Bash and WSL.
*.sh         text eol=lf

# Binary assets: never normalise, diff or merge these.
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.bmp          binary
*.webp         binary
*.ttf          binary
*.otf          binary
*.woff         binary
*.woff2        binary
*.exe          binary
*.dll          binary
*.pdb          binary
*.msix         binary
*.msixbundle   binary
*.appx         binary
*.appxbundle   binary
*.msi          binary
*.zip          binary
*.pfx          binary
*.snk          binary
