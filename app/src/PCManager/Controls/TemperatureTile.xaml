<UserControl x:Class="PCManager.Controls.TemperatureTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCManager.Controls"
             Focusable="False">
    <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}"
                AutomationProperties.Name="{Binding AutomationName}">
        <controls:Icon3D Key="Temperature" Size="14" Tint="Neutral" VerticalAlignment="Center" />
        <StackPanel Margin="{StaticResource Thickness.1}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ValueText" Text="{Binding ValueText}" FontSize="12" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Warm">
                                    <Setter Property="Foreground" Value="{DynamicResource App.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Hot">
                                    <Setter Property="Foreground" Value="{DynamicResource App.Critical}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock x:Name="LabelText" Text="{Binding Label}" FontSize="10"
                           Margin="{StaticResource Thickness.1}" VerticalAlignment="Center"
                           Foreground="{DynamicResource App.Subtle}" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontSize="9.5"
                       Foreground="{DynamicResource App.Subtle}" TextTrimming="CharacterEllipsis"
                       MaxWidth="170" />
        </StackPanel>
    </StackPanel>
</UserControl>
