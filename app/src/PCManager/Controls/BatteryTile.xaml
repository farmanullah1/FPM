<UserControl x:Class="PCManager.Controls.BatteryTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCManager.Controls"
             Focusable="False">
    <Grid Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}"
          AutomationProperties.Name="{Binding AutomationName}"
          ToolTip="{Binding Tooltip}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <controls:Icon3D Key="Battery" Size="14" Tint="Neutral" VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Margin="{StaticResource Thickness.1}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding PercentText}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding DetailText}" FontSize="10" Margin="{StaticResource Thickness.1}"
                           Foreground="{DynamicResource App.Subtle}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="DetailRow" Orientation="Horizontal">
                <TextBlock Text="{Binding TimeText}" FontSize="9.5"
                           Foreground="{DynamicResource App.Subtle}" />
                <TextBlock Text="{Binding HealthBadgeText}" FontSize="9.5" Margin="{StaticResource Thickness.2}"
                           Foreground="{DynamicResource App.Subtle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
