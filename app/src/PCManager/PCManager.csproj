<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PCManager</RootNamespace>
    <!-- Distinct executable name: FPM.exe vs MSPCManager.exe. -->
    <AssemblyName>FPM</AssemblyName>
    <Product>FPM</Product>
    <AssemblyTitle>FPM</AssemblyTitle>
    <Version>3.23.3.0</Version>
    <AssemblyVersion>3.23.3.0</AssemblyVersion>
    <FileVersion>3.23.3.0</FileVersion>
    <Company>PCManager</Company>
    <Description>FPM - Windows PC Manager utility.</Description>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- The WPF shell must stay crisp at 125% display scaling; the WinForms tray needs the
         same mode. This property emits the awareness into the generated manifest. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- WinForms is referenced only for the tray icon (NotifyIcon). Drop its global using so
       UserControl/Application keep resolving to the WPF types. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\PCManager.Core.csproj" />
    <ProjectReference Include="..\Services\PCManager.Services.csproj" />
    <ProjectReference Include="..\ViewModels\PCManager.ViewModels.csproj" />
    <!-- Build ordering only: the helper is a separate requireAdministrator executable. -->
    <ProjectReference Include="..\Helper\PCManager.Helper.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Ship the helper next to the UI. It is the only binary with a requireAdministrator manifest. -->
  <Target Name="CopyElevatedHelper" AfterTargets="Build">
    <ItemGroup>
      <ElevatedHelperFiles Include="..\Helper\bin\$(Configuration)\net8.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ElevatedHelperFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

</Project>
