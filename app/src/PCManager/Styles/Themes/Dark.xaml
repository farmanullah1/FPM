<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Warm dark palette; same keys as Light.xaml. -->
    <SolidColorBrush x:Key="App.Background" Color="#1F1C16" />
    <SolidColorBrush x:Key="App.Rail" Color="#191712" />
    <SolidColorBrush x:Key="App.Card" Color="#2B2721" />
    <SolidColorBrush x:Key="App.CardHover" Color="#35302A" />
    <SolidColorBrush x:Key="App.Border" Color="#443C2E" />
    <SolidColorBrush x:Key="App.Text" Color="#FFF8E7" />
    <SolidColorBrush x:Key="App.Subtle" Color="#C9BFA6" />
    <SolidColorBrush x:Key="App.Accent" Color="#F2C14E" />
    <SolidColorBrush x:Key="App.AccentSoft" Color="#3A3020" />
    <SolidColorBrush x:Key="App.AccentText" Color="#241C0C" />
    <SolidColorBrush x:Key="App.Success" Color="#9BC46A" />
    <SolidColorBrush x:Key="App.Warning" Color="#F2C14E" />
    <SolidColorBrush x:Key="App.Critical" Color="#FF9A8F" />
    <SolidColorBrush x:Key="App.Selection" Color="#3E3524" />
    <SolidColorBrush x:Key="App.Track" Color="#3A342A" />

</ResourceDictionary>
