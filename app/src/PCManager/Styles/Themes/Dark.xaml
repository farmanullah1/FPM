<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Obsidian & Gold Dark Mode: canonical v5 palette -->
    <SolidColorBrush x:Key="App.Background" Color="#121214" />
    <SolidColorBrush x:Key="App.Rail" Color="#171719" />
    <SolidColorBrush x:Key="App.Card" Color="#1C1C1F" />
    <SolidColorBrush x:Key="App.CardHover" Color="#26262A" />
    <SolidColorBrush x:Key="App.Border" Color="#3B3730" />
    <SolidColorBrush x:Key="App.WindowBorder" Color="#3B3730" />
    <SolidColorBrush x:Key="App.Text" Color="#F9FAFB" />
    <SolidColorBrush x:Key="App.Subtle" Color="#C8C5BE" />
    <SolidColorBrush x:Key="App.Accent" Color="#FACC15" />
    <SolidColorBrush x:Key="App.AccentSoft" Color="#3A3016" />
    <SolidColorBrush x:Key="App.AccentText" Color="#18181B" />
    <SolidColorBrush x:Key="App.AccentLabel" Color="#FACC15" />
    <SolidColorBrush x:Key="App.Success" Color="#34D399" />
    <SolidColorBrush x:Key="App.Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="App.Critical" Color="#F87171" />
    <SolidColorBrush x:Key="App.Selection" Color="#3A3016" />
    <SolidColorBrush x:Key="App.Track" Color="#3F3F46" />

    <!-- Aliases kept for the responsive shell's command palette (v7 token names). -->
    <SolidColorBrush x:Key="App.CardBackground" Color="#1C1C1F" />
    <SolidColorBrush x:Key="App.RowBackground" Color="#26262A" />
    <SolidColorBrush x:Key="App.Hover" Color="#26262A" />
    <SolidColorBrush x:Key="App.Gold" Color="#FACC15" />
    <SolidColorBrush x:Key="App.TextSubtle" Color="#C8C5BE" />

    <!-- ===================== U1: surfaces, states, ramps ===================== -->

    <!-- Elevation. Dark mode raises surfaces by getting lighter. -->
    <SolidColorBrush x:Key="Surface.0" Color="#121214" />
    <SolidColorBrush x:Key="Surface.1" Color="#1C1C1F" />
    <SolidColorBrush x:Key="Surface.2" Color="#26262A" />
    <SolidColorBrush x:Key="Surface.3" Color="#2E2E33" />

    <!-- Interaction states: amber tints that read on dark surfaces. -->
    <SolidColorBrush x:Key="State.Hover" Color="#14FBBF24" />
    <SolidColorBrush x:Key="State.Pressed" Color="#24FBBF24" />
    <SolidColorBrush x:Key="State.Selected" Color="#3A3016" />

    <!-- Accent interaction ramp (v7 8.1). -->
    <SolidColorBrush x:Key="App.AccentHover" Color="#F59E0B" />
    <SolidColorBrush x:Key="App.AccentPressed" Color="#D97706" />
    <SolidColorBrush x:Key="App.AccentBorder" Color="#EAB308" />
    <SolidColorBrush x:Key="App.AccentBar" Color="#FACC15" />

    <!-- Amber ramp for icons, gradients and charts. -->
    <SolidColorBrush x:Key="Amber.50" Color="#FFFBEB" />
    <SolidColorBrush x:Key="Amber.100" Color="#FEF3C7" />
    <SolidColorBrush x:Key="Amber.200" Color="#FDE68A" />
    <SolidColorBrush x:Key="Amber.300" Color="#FCD34D" />
    <SolidColorBrush x:Key="Amber.400" Color="#FBBF24" />
    <SolidColorBrush x:Key="Amber.500" Color="#F59E0B" />
    <SolidColorBrush x:Key="Amber.600" Color="#D97706" />
    <SolidColorBrush x:Key="Amber.700" Color="#B45309" />
    <SolidColorBrush x:Key="Amber.800" Color="#92400E" />
    <SolidColorBrush x:Key="Amber.900" Color="#78350F" />

    <!-- Hero-only gradient; every other surface stays flat (v7 8.1). -->
    <LinearGradientBrush x:Key="Gradient.GoldHero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FCD34D" Offset="0" />
        <GradientStop Color="#F59E0B" Offset="1" />
    </LinearGradientBrush>

    <!-- Semantic fills for bars/dots/icons, and the text-safe variants. -->
    <SolidColorBrush x:Key="App.Success.Fill" Color="#34D399" />
    <SolidColorBrush x:Key="App.Warning.Fill" Color="#FBBF24" />
    <SolidColorBrush x:Key="App.Critical.Fill" Color="#F87171" />
    <SolidColorBrush x:Key="App.Success.Text" Color="#34D399" />
    <SolidColorBrush x:Key="App.Warning.Text" Color="#FBBF24" />
    <SolidColorBrush x:Key="App.Critical.Text" Color="#F87171" />

    <!-- Six distinguishable chart colours (always paired with a label). -->
    <SolidColorBrush x:Key="Chart.1" Color="#FBBF24" />
    <SolidColorBrush x:Key="Chart.2" Color="#34D399" />
    <SolidColorBrush x:Key="Chart.3" Color="#60A5FA" />
    <SolidColorBrush x:Key="Chart.4" Color="#22D3EE" />
    <SolidColorBrush x:Key="Chart.5" Color="#A78BFA" />
    <SolidColorBrush x:Key="Chart.6" Color="#F87171" />

</ResourceDictionary>
