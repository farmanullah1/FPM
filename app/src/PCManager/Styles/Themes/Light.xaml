<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Ultra-compact warm golden-yellow palette. Every control binds these through
         DynamicResource so swapping the dictionary re-themes the shell instantly. -->
    <SolidColorBrush x:Key="App.Background" Color="#F7F6F2" />
    <SolidColorBrush x:Key="App.Rail" Color="#F7F6F2" />
    <SolidColorBrush x:Key="App.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.CardHover" Color="#FFFDF7" />
    <SolidColorBrush x:Key="App.Border" Color="#EAE6DC" />
    <SolidColorBrush x:Key="App.WindowBorder" Color="#E6E2D6" />
    <SolidColorBrush x:Key="App.Text" Color="#18181B" />
    <SolidColorBrush x:Key="App.Subtle" Color="#57534E" />
    <SolidColorBrush x:Key="App.Accent" Color="#F59E0B" />
    <SolidColorBrush x:Key="App.AccentSoft" Color="#FEF3C7" />
    <SolidColorBrush x:Key="App.AccentText" Color="#18181B" />
    <SolidColorBrush x:Key="App.AccentLabel" Color="#B45309" />
    <SolidColorBrush x:Key="App.Success" Color="#15803D" />
    <SolidColorBrush x:Key="App.Warning" Color="#B45309" />
    <SolidColorBrush x:Key="App.Critical" Color="#B91C1C" />
    <SolidColorBrush x:Key="App.Selection" Color="#FEF3C7" />
    <SolidColorBrush x:Key="App.Track" Color="#F1EDE2" />

    <!-- Aliases kept for the responsive shell's command palette (v7 token names). -->
    <SolidColorBrush x:Key="App.CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.RowBackground" Color="#FFFDF7" />
    <SolidColorBrush x:Key="App.Hover" Color="#FFFDF7" />
    <SolidColorBrush x:Key="App.Gold" Color="#F59E0B" />
    <SolidColorBrush x:Key="App.TextSubtle" Color="#57534E" />

    <!-- ===================== U1: surfaces, states, ramps ===================== -->

    <!-- Elevation. Light mode raises surfaces with shadow, so 2 is a hair warmer
         than 1 and 3 stays white for dialogs. -->
    <SolidColorBrush x:Key="Surface.0" Color="#F7F6F2" />
    <SolidColorBrush x:Key="Surface.1" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface.2" Color="#FFFDF7" />
    <SolidColorBrush x:Key="Surface.3" Color="#FFFFFF" />

    <!-- Interaction states: 6 % hover tint, 10 % pressed tint over the surface. -->
    <SolidColorBrush x:Key="State.Hover" Color="#0FF59E0B" />
    <SolidColorBrush x:Key="State.Pressed" Color="#1AF59E0B" />
    <SolidColorBrush x:Key="State.Selected" Color="#FEF3C7" />

    <!-- Accent interaction ramp (v7 8.1 / 8.2-D4). Pressed stays light enough
         for charcoal text to keep 4.5:1. -->
    <SolidColorBrush x:Key="App.AccentHover" Color="#D97706" />
    <SolidColorBrush x:Key="App.AccentPressed" Color="#D4730A" />
    <SolidColorBrush x:Key="App.AccentBorder" Color="#EAB308" />
    <!-- Progress/bar fill: darker than the button gold so it clears 3:1 on the track. -->
    <SolidColorBrush x:Key="App.AccentBar" Color="#B45309" />

    <!-- Amber ramp for icons, gradients and charts. -->
    <SolidColorBrush x:Key="Amber.50" Color="#FFFBEB" />
    <SolidColorBrush x:Key="Amber.100" Color="#FEF3C7" />
    <SolidColorBrush x:Key="Amber.200" Color="#FDE68A" />
    <SolidColorBrush x:Key="Amber.300" Color="#FCD34D" />
    <SolidColorBrush x:Key="Amber.400" Color="#FBBF24" />
    <SolidColorBrush x:Key="Amber.500" Color="#F59E0B" />
    <SolidColorBrush x:Key="Amber.600" Color="#D97706" />
    <SolidColorBrush x:Key="Amber.700" Color="#B45309" />
    <SolidColorBrush x:Key="Amber.800" Color="#92400E" />
    <SolidColorBrush x:Key="Amber.900" Color="#78350F" />

    <!-- Hero-only gradient; every other surface stays flat (v7 8.1). -->
    <LinearGradientBrush x:Key="Gradient.GoldHero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FCD34D" Offset="0" />
        <GradientStop Color="#F59E0B" Offset="1" />
    </LinearGradientBrush>

    <!-- Semantic fills for bars/dots/icons, and the text-safe variants that
         words must use (v7 8.2-D3). -->
    <!-- The bright 8.1 fills fail 3:1 against the light track, so bars and dots use
         these darkened variants (v7 8.2-D3 allows exactly this correction). -->
    <SolidColorBrush x:Key="App.Success.Fill" Color="#047857" />
    <SolidColorBrush x:Key="App.Warning.Fill" Color="#B45309" />
    <SolidColorBrush x:Key="App.Critical.Fill" Color="#EF4444" />
    <SolidColorBrush x:Key="App.Success.Text" Color="#047857" />
    <SolidColorBrush x:Key="App.Warning.Text" Color="#B45309" />
    <SolidColorBrush x:Key="App.Critical.Text" Color="#B91C1C" />

    <!-- Icon3D palette (U2). Face gradient (light upper-left to dark lower-right), the
         extrusion step behind it, and the shadow the compositor uses for its offset copies.
         Neutral parts (screen cut-outs, secondary glyphs) are graphite in both themes. -->
    <SolidColorBrush x:Key="Icon.Gold.FaceFrom" Color="#FCD34D" />
    <SolidColorBrush x:Key="Icon.Gold.FaceTo" Color="#D97706" />
    <SolidColorBrush x:Key="Icon.Gold.Depth" Color="#92400E" />
    <SolidColorBrush x:Key="Icon.Neutral.FaceFrom" Color="#A8A29E" />
    <SolidColorBrush x:Key="Icon.Neutral.FaceTo" Color="#57534E" />
    <SolidColorBrush x:Key="Icon.Neutral.Depth" Color="#292524" />
    <SolidColorBrush x:Key="Icon.Success.FaceFrom" Color="#6EE7B7" />
    <SolidColorBrush x:Key="Icon.Success.FaceTo" Color="#047857" />
    <SolidColorBrush x:Key="Icon.Success.Depth" Color="#064E3B" />
    <SolidColorBrush x:Key="Icon.Warning.FaceFrom" Color="#FDE68A" />
    <SolidColorBrush x:Key="Icon.Warning.FaceTo" Color="#B45309" />
    <SolidColorBrush x:Key="Icon.Warning.Depth" Color="#78350F" />
    <SolidColorBrush x:Key="Icon.Critical.FaceFrom" Color="#FCA5A5" />
    <SolidColorBrush x:Key="Icon.Critical.FaceTo" Color="#B91C1C" />
    <SolidColorBrush x:Key="Icon.Critical.Depth" Color="#7F1D1D" />
    <SolidColorBrush x:Key="Icon.Shadow" Color="#3F3A2E" />

    <!-- Six distinguishable chart colours (always paired with a label). -->
    <SolidColorBrush x:Key="Chart.1" Color="#B45309" />
    <SolidColorBrush x:Key="Chart.2" Color="#15803D" />
    <SolidColorBrush x:Key="Chart.3" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Chart.4" Color="#0E7490" />
    <SolidColorBrush x:Key="Chart.5" Color="#7C3AED" />
    <SolidColorBrush x:Key="Chart.6" Color="#B91C1C" />

</ResourceDictionary>
