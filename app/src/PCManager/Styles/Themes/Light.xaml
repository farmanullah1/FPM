<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Warm "sand" Fluent palette: the same Windows 11 card geometry and spacing as
         PC Manager, tinted amber instead of blue. Every control binds these through
         DynamicResource so swapping the dictionary re-themes the shell instantly. -->
    <SolidColorBrush x:Key="App.Background" Color="#F7F3E8" />
    <SolidColorBrush x:Key="App.Rail" Color="#F1EAD9" />
    <SolidColorBrush x:Key="App.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.CardHover" Color="#FBF6EA" />
    <SolidColorBrush x:Key="App.Border" Color="#E8E0CC" />
    <SolidColorBrush x:Key="App.Text" Color="#2A241A" />
    <SolidColorBrush x:Key="App.Subtle" Color="#7A6E55" />
    <SolidColorBrush x:Key="App.Accent" Color="#C98A00" />
    <SolidColorBrush x:Key="App.AccentSoft" Color="#FBF0D2" />
    <SolidColorBrush x:Key="App.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Success" Color="#4F7A28" />
    <SolidColorBrush x:Key="App.Warning" Color="#B26A00" />
    <SolidColorBrush x:Key="App.Critical" Color="#B3261E" />
    <SolidColorBrush x:Key="App.Selection" Color="#F5E8C6" />
    <SolidColorBrush x:Key="App.Track" Color="#EFE7D3" />

</ResourceDictionary>
