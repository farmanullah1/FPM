<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Ultra-compact warm golden-yellow palette. Every control binds these through
         DynamicResource so swapping the dictionary re-themes the shell instantly. -->
    <SolidColorBrush x:Key="App.Background" Color="#F7F6F2" />
    <SolidColorBrush x:Key="App.Rail" Color="#F7F6F2" />
    <SolidColorBrush x:Key="App.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.CardHover" Color="#FFFDF7" />
    <SolidColorBrush x:Key="App.Border" Color="#EAE6DC" />
    <SolidColorBrush x:Key="App.WindowBorder" Color="#E6E2D6" />
    <SolidColorBrush x:Key="App.Text" Color="#18181B" />
    <SolidColorBrush x:Key="App.Subtle" Color="#57534E" />
    <SolidColorBrush x:Key="App.Accent" Color="#F59E0B" />
    <SolidColorBrush x:Key="App.AccentSoft" Color="#FEF3C7" />
    <SolidColorBrush x:Key="App.AccentText" Color="#18181B" />
    <SolidColorBrush x:Key="App.AccentLabel" Color="#B45309" />
    <SolidColorBrush x:Key="App.Success" Color="#15803D" />
    <SolidColorBrush x:Key="App.Warning" Color="#B45309" />
    <SolidColorBrush x:Key="App.Critical" Color="#B91C1C" />
    <SolidColorBrush x:Key="App.Selection" Color="#FEF3C7" />
    <SolidColorBrush x:Key="App.Track" Color="#F1EDE2" />

</ResourceDictionary>
