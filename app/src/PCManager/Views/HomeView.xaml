<UserControl x:Class="PCManager.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="HomeLayout" MaxWidth="1280" HorizontalAlignment="Stretch" Margin="10,9,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================ A: contextual tip ============================ -->
            <Border x:Name="TipCard" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                    Style="{StaticResource Card}" Padding="9,10" Margin="0,0,0,8"
                    Visibility="{Binding IsTipVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36" CornerRadius="8"
                            Background="{DynamicResource App.AccentSoft}"
                            VerticalAlignment="Center">
                        <Grid>
                            <Path Data="{DynamicResource Icon.Window}"
                                  Fill="{DynamicResource App.Accent}"
                                  Width="19" Height="19" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource App.AccentLabel}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="Switch between open Windows" FontSize="12" FontWeight="Bold" />
                        <TextBlock Text="Press Win + Tab to switch open windows or virtual desktops."
                                   FontSize="10.5" Foreground="{DynamicResource App.Subtle}"
                                   TextWrapping="Wrap" Margin="0,1,0,0" />
                        <Button Style="{StaticResource PillButton}" Command="{Binding OpenTipsCommand}"
                                HorizontalAlignment="Left" Padding="0,2,0,0" Margin="0,1,0,0"
                                ToolTip="Open the Windows keyboard-shortcut tips in your browser">
                            <TextBlock Text="Discover more tips &#x203A;"
                                       FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.AccentLabel}" />
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource CaptionButton}"
                            Width="18" Height="18" VerticalAlignment="Top"
                            Command="{Binding DismissTipCommand}" ToolTip="Dismiss tip">
                        <TextBlock Text="&#x2715;" FontSize="8" />
                    </Button>
                </Grid>
            </Border>

            <!-- ============================ B: PC boost hero ============================ -->
            <Border x:Name="BoostCard" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Style="{StaticResource Card}" Padding="11,12" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{DynamicResource Icon.Speed}" Fill="#D97706"
                                  Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="PC boost" FontSize="12.5" FontWeight="Bold"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                  Content="Smart boost"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding SmartBoostEnabled, Mode=TwoWay}"
                                  ToolTip="Trim memory automatically when usage crosses the threshold" />
                    </Grid>

                    <TextBlock Text="{Binding BoostStatusText}"
                               FontSize="10.5" Foreground="{DynamicResource App.Subtle}"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

                    <Grid Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" CornerRadius="1.5"
                                    Background="{DynamicResource App.Accent}"
                                    Margin="0,2,0,9" />
                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock Text="{Binding LoadText}" FontSize="19" FontWeight="Bold"
                                           FontFamily="Segoe UI Variable Display, Segoe UI" />
                                <TextBlock Text="Memory usage" FontSize="9.5"
                                           Foreground="{DynamicResource App.Subtle}" />
                                <ProgressBar Style="{StaticResource ThinProgress}" Height="3"
                                             Margin="0,4,0,0" Value="{Binding LoadPercent}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" CornerRadius="1.5"
                                    Background="{DynamicResource App.Accent}"
                                    Margin="0,2,0,9" />
                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock Text="{Binding TempFilesText}" FontSize="19" FontWeight="Bold"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Temporary files" FontSize="9.5"
                                           Foreground="{DynamicResource App.Subtle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="30"
                                HorizontalAlignment="Stretch"
                                Command="{Binding BoostCommand}"
                                ToolTip="Trim process working sets and delete temporary files">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{DynamicResource Icon.Bolt}" Fill="#18181B"
                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding BoostButtonText}" FontSize="12" FontWeight="Bold"
                                           Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="30"
                                HorizontalAlignment="Stretch"
                                Command="{Binding CleanEverythingCommand}"
                                ToolTip="Run unified scan across all supported categories">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{DynamicResource Icon.Storage}" Fill="{DynamicResource App.Text}"
                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="Clean Everything" FontSize="11" FontWeight="SemiBold"
                                           Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding ResultText}" FontSize="9"
                               Foreground="{DynamicResource App.Subtle}"
                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ResultText}" />
                </StackPanel>
            </Border>

            <!-- ============================ C: 2x2 quick actions ============================ -->
            <Grid x:Name="UtilityGrid" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Health check -->
                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource ActionCard}"
                        Margin="0,0,4,4" MinHeight="76" Command="{Binding OpenProtectionCommand}"
                        ToolTip="Open Protection: Defender, updates and firewall">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Health check" FontSize="11.5" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Path Data="{DynamicResource Icon.Health}" Fill="{DynamicResource App.Accent}"
                                      Width="13" Height="13" Stretch="Uniform" />
                                <TextBlock Text="&#x203A;" FontSize="12" Margin="3,0,0,0"
                                           Foreground="{DynamicResource App.Subtle}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                            <TextBlock Text="Protection &amp; updates" FontSize="9"
                                       Foreground="{DynamicResource App.Subtle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Check status" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.AccentLabel}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Process -->
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource ActionCard}"
                        Margin="4,0,0,4" MinHeight="76" Command="{Binding OpenProcessesCommand}"
                        ToolTip="Open Apps: running processes and End Task">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Process" FontSize="11.5" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Path Data="{DynamicResource Icon.Process}" Fill="{DynamicResource App.Accent}"
                                      Width="13" Height="13" Stretch="Uniform" />
                                <TextBlock Text="&#x203A;" FontSize="12" Margin="3,0,0,0"
                                           Foreground="{DynamicResource App.Subtle}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                            <TextBlock Text="Running now" FontSize="9"
                                       Foreground="{DynamicResource App.Subtle}" />
                            <TextBlock Text="{Binding ProcessCountText}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.AccentLabel}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Deep cleanup -->
                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource ActionCard}"
                        Margin="0,4,4,0" MinHeight="76" Command="{Binding OpenCleanupCommand}"
                        ToolTip="Open Storage: Cleanup Center and duplicate files">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Deep cleanup" FontSize="11.5" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Path Data="{DynamicResource Icon.Cleanup}" Fill="{DynamicResource App.Accent}"
                                      Width="13" Height="13" Stretch="Uniform" />
                                <TextBlock Text="&#x203A;" FontSize="12" Margin="3,0,0,0"
                                           Foreground="{DynamicResource App.Subtle}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                            <TextBlock Text="Local Disk (C:)" FontSize="9"
                                       Foreground="{DynamicResource App.Subtle}" />
                            <TextBlock Text="{Binding DiskUsageText}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.AccentLabel}" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <ProgressBar Style="{StaticResource ThinProgress}" Height="2.5"
                                         Margin="0,3,0,0" Value="{Binding DiskUsedPercent}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Startup -->
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ActionCard}"
                        Margin="4,4,0,0" MinHeight="76" Command="{Binding OpenStartupCommand}"
                        ToolTip="Open Apps: startup programs">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Startup" FontSize="11.5" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Path Data="{DynamicResource Icon.Startup}" Fill="{DynamicResource App.Accent}"
                                      Width="13" Height="13" Stretch="Uniform" />
                                <TextBlock Text="&#x203A;" FontSize="12" Margin="3,0,0,0"
                                           Foreground="{DynamicResource App.Subtle}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="Manage startup apps in system settings"
                                   FontSize="9" Foreground="{DynamicResource App.Subtle}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </Grid>
                </Button>
            </Grid>

            <!-- ============================ D: compact capture strip ============================ -->
            <Border x:Name="CaptureCard" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                    Style="{StaticResource Card}" Padding="9,10" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="6"
                                Background="{StaticResource App.GoldFill}" VerticalAlignment="Center">
                            <Path Data="{DynamicResource Icon.Screenshot}" Fill="#FFFBEB"
                                  Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="9,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="Quick capture" FontSize="12" FontWeight="Bold" />
                            <TextBlock Text="Screenshot every monitor to Pictures"
                                       FontSize="9.5" Foreground="{DynamicResource App.Subtle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource OutlineGoldButton}"
                            Content="Capture" Command="{Binding CaptureCommand}"
                            VerticalAlignment="Center"
                            ToolTip="{Binding StatusMessage}" />
                </Grid>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" FontSize="9"
                       Foreground="{DynamicResource App.Subtle}"
                       Margin="2,5,2,0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusMessage}" />
        </Grid>
    </ScrollViewer>
</UserControl>
