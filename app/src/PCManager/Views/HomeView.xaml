<UserControl x:Class="PCManager.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,28,28">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Home" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="Keep this PC fast — one click frees memory and removes temporary files." />
                </StackPanel>
            </Grid>

            <!-- PC Boost hero -->
            <Border Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Memory usage" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding LoadText}" FontSize="52" FontWeight="Bold"
                                       Foreground="{DynamicResource App.Accent}" Margin="0,-4,0,0" />
                            <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding LoadPercent, Mode=OneWay}"
                                         Margin="0,6,0,8" MaxWidth="420" HorizontalAlignment="Left" Width="420" />
                            <TextBlock Text="{Binding AvailableText}" Style="{StaticResource CaptionText}" />
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="{DynamicResource App.Border}" Margin="0,4,0,4" />

                        <StackPanel Grid.Column="2" Margin="28,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Temporary files" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding TempFilesText}" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock Text="Removed automatically with every Boost."
                                       Style="{StaticResource CaptionText}" MaxWidth="240" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Boost" Style="{StaticResource PrimaryButton}"
                                    MinWidth="132" Command="{Binding BoostCommand}" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Smart Boost"
                                      Margin="20,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding SmartBoostEnabled, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="420" />
                    </Grid>

                    <TextBlock Text="{Binding ResultText}" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Quick actions -->
            <TextBlock Text="Quick actions" Style="{StaticResource SectionTitle}" Margin="0,6,0,10" />
            <UniformGrid Columns="2" Rows="2">
                <Button Style="{StaticResource ActionCard}" Command="{Binding OpenProtectionCommand}">
                    <StackPanel>
                        <Path Data="{DynamicResource Icon.Health}" Fill="{DynamicResource App.Accent}"
                              Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Left" />
                        <TextBlock Text="Health check" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <TextBlock Text="Defender, updates and protection status." Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionCard}" Command="{Binding OpenProcessesCommand}">
                    <StackPanel>
                        <Path Data="{DynamicResource Icon.Process}" Fill="{DynamicResource App.Accent}"
                              Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Left" />
                        <TextBlock Text="Process" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <TextBlock Text="Live apps with memory usage and End." Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionCard}" Command="{Binding OpenCleanupCommand}">
                    <StackPanel>
                        <Path Data="{DynamicResource Icon.Cleanup}" Fill="{DynamicResource App.Accent}"
                              Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Left" />
                        <TextBlock Text="Deep cleanup" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <TextBlock Text="Update cache, logs, temp and browser caches." Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionCard}" Command="{Binding OpenStartupCommand}">
                    <StackPanel>
                        <Path Data="{DynamicResource Icon.Startup}" Fill="{DynamicResource App.Accent}"
                              Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Left" />
                        <TextBlock Text="Startup" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <TextBlock Text="Turn programs that start with Windows on or off." Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
