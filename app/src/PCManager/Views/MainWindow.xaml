<Window x:Class="PCManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPM"
        Width="370" Height="610"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Slim rail entry: icon over a 9.5px label, amber when active. -->
        <DataTemplate x:Key="NavigationItemTemplate">
            <StackPanel HorizontalAlignment="Center" ToolTip="{Binding Title}">
                <Path x:Name="NavIcon"
                      Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                      Fill="{DynamicResource App.Subtle}"
                      Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" />
                <TextBlock x:Name="NavLabel"
                           Text="{Binding Title}"
                           FontSize="9.5" FontWeight="Medium"
                           Foreground="{DynamicResource App.Subtle}"
                           HorizontalAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="NavIcon" Property="Fill" Value="{DynamicResource App.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="NavIcon" Property="Fill" Value="{DynamicResource App.Accent}" />
                    <Setter TargetName="NavLabel" Property="Foreground" Value="{DynamicResource App.AccentLabel}" />
                    <Setter TargetName="NavLabel" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- 10px transparent margin so the elevation shadow is not clipped; the visible
         utility surface inside is exactly 350 x 590. -->
    <Border x:Name="Shell"
            Width="350" Height="590"
            CornerRadius="10"
            Background="{DynamicResource App.Background}"
            BorderBrush="{DynamicResource App.WindowBorder}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270"
                              Opacity="0.20" Color="#3F3A2E" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======================= Compact title bar ======================= -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Path Data="{DynamicResource Icon.Logo}"
                          Fill="{DynamicResource App.Accent}"
                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="FPM"
                               FontSize="11.5" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button x:Name="PinButton" Style="{StaticResource CaptionButton}"
                            Click="Pin_Click" ToolTip="Pin on top">
                        <Path x:Name="PinIcon" Data="{DynamicResource Icon.Pin}"
                              Fill="{DynamicResource App.Subtle}"
                              Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}"
                            Click="Minimise_Click" ToolTip="Minimise">
                        <TextBlock Text="&#x2013;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}"
                            Click="Close_Click" ToolTip="Close">
                        <TextBlock Text="&#x2715;" FontSize="9.5" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ======================= Body ======================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource App.Rail}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,10">
                    <DockPanel Margin="4,4,4,8">
                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Height="1" Background="{DynamicResource App.Border}" Margin="6,5,6,5" />
                            <ListBox Style="{StaticResource NavList}"
                                     ItemsSource="{Binding SettingsItems}"
                                     ItemTemplate="{StaticResource NavigationItemTemplate}"
                                     SelectedItem="{Binding SelectedPage, Mode=TwoWay}" />
                        </StackPanel>

                        <ListBox Style="{StaticResource NavList}"
                                 ItemsSource="{Binding Pages}"
                                 ItemTemplate="{StaticResource NavigationItemTemplate}"
                                 SelectedItem="{Binding SelectedPage, Mode=TwoWay}" />
                    </DockPanel>
                </Border>

                <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
            </Grid>
        </Grid>
    </Border>
</Window>
