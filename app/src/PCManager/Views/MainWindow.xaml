<Window x:Class="PCManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Farmanullah PC Manager"
        Height="820" Width="1280"
        MinHeight="660" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================= Title bar ======================= -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <Path Data="{DynamicResource Icon.Logo}"
                      Fill="{DynamicResource App.Accent}"
                      Width="16" Height="16" Stretch="Uniform" />
                <TextBlock Text="Farmanullah PC Manager" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Background="{DynamicResource App.AccentSoft}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                    <TextBlock Text="v3.23" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource App.Accent}" />
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="Minimise_Click" ToolTip="Minimise">
                    <Path Data="{DynamicResource Icon.Minimise}" Stroke="{DynamicResource App.Text}"
                          StrokeThickness="1.4" Width="10" Height="10" Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="Maximise_Click" ToolTip="Maximise">
                    <Path Data="{DynamicResource Icon.Maximise}" Stroke="{DynamicResource App.Text}"
                          StrokeThickness="1.2" Width="10" Height="10" Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="Close">
                    <Path Data="{DynamicResource Icon.Close}" Stroke="{DynamicResource App.Text}"
                          StrokeThickness="1.4" Width="10" Height="10" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================= Body ======================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource App.Rail}">
                <DockPanel Margin="12,10,12,12">

                    <!-- Pinned bottom: Settings + product/version -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{DynamicResource App.Border}" Margin="6,8,6,8" />
                        <ListBox Style="{StaticResource NavList}"
                                 ItemsSource="{Binding SettingsItems}"
                                 SelectedItem="{Binding SelectedPage, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                              Fill="{DynamicResource App.Text}"
                                              Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                                        <StackPanel Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionText}" Margin="12,8,0,0" />
                    </StackPanel>

                    <!-- Main tabs -->
                    <ListBox Style="{StaticResource NavList}"
                             ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding SelectedPage, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                          Fill="{DynamicResource App.Text}"
                                          Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
