<Window x:Class="PCManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PCManager.Controls"
        Title="FPM"
        Icon="pack://application:,,,/Assets/fpm.ico"
        Width="560" Height="780"
        MinWidth="360" MinHeight="520"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="10" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding ToggleCommandPaletteCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Adaptive Navigation Item Template -->
        <DataTemplate x:Key="NavigationItemTemplate">
            <Grid ToolTip="{Binding Title}" Margin="2,1">
                <!-- Compact & Standard Rail Layout (< 960 px) -->
                <StackPanel HorizontalAlignment="Center" Margin="0,4"
                            Visibility="{Binding DataContext.IsExpandedSidebar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}">
                    <controls:Icon3D x:Name="NavIcon"
                                     Key="{Binding Icon3DKey}"
                                     Size="18"
                                     Tint="Neutral"
                                     HorizontalAlignment="Center" />
                    <TextBlock x:Name="NavLabel"
                               Text="{Binding Title}"
                               FontSize="9.5" FontWeight="Medium"
                               Foreground="{DynamicResource App.Subtle}"
                               HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>

                <!-- Expanded Sidebar Layout (>= 960 px) -->
                <Grid Margin="4,3"
                      Visibility="{Binding DataContext.IsExpandedSidebar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:Icon3D x:Name="NavIconExpanded"
                                     Key="{Binding Icon3DKey}"
                                     Size="20"
                                     Tint="Neutral"
                                     VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock x:Name="NavTitleExpanded" Text="{Binding Title}"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource App.Text}" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                   Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="NavIcon" Property="Tint" Value="Gold" />
                    <Setter TargetName="NavIconExpanded" Property="Tint" Value="Gold" />
                    <Setter TargetName="NavLabel" Property="Foreground" Value="{DynamicResource App.AccentLabel}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="NavIcon" Property="Tint" Value="Gold" />
                    <Setter TargetName="NavIconExpanded" Property="Tint" Value="Gold" />
                    <Setter TargetName="NavLabel" Property="Foreground" Value="{DynamicResource App.AccentLabel}" />
                    <Setter TargetName="NavLabel" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="NavTitleExpanded" Property="Foreground" Value="{DynamicResource App.AccentLabel}" />
                    <Setter TargetName="NavTitleExpanded" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- Main Shell Surface with Ambient Shadow -->
    <Border x:Name="Shell"
            CornerRadius="10"
            Background="{DynamicResource App.Background}"
            BorderBrush="{DynamicResource App.WindowBorder}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270"
                              Opacity="0.20" Color="#3F3A2E" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======================= Custom Chrome Titlebar ======================= -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Image Source="{StaticResource Brand.Emblem}"
                           Width="17" Height="17" Stretch="Uniform"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="FPM emblem" />
                    <TextBlock Text="FPM"
                               FontSize="11.5" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Button Content="Ctrl+K" Style="{StaticResource PillButton}" Padding="6,1" FontSize="9.5"
                            ToolTip="Open Command Palette (Ctrl+K)"
                            Command="{Binding ToggleCommandPaletteCommand}"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button x:Name="PinButton" Style="{StaticResource CaptionButton}"
                            Click="Pin_Click" ToolTip="Pin on top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path x:Name="PinIcon" Data="{DynamicResource Icon.Pin}"
                              Fill="{DynamicResource App.Subtle}"
                              Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}"
                            Click="Minimise_Click" ToolTip="Minimise"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#x2013;" FontSize="12" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                            Click="Maximize_Click" ToolTip="Maximize / Restore"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="MaximizeIconText" Text="&#x25A2;" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}"
                            Click="Close_Click" ToolTip="Close"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#x2715;" FontSize="9.5" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ======================= Body Layout ======================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RailColumn" Width="68" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Rail / Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource App.Rail}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,10">
                    <DockPanel Margin="4,4,4,8">
                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Height="1" Background="{DynamicResource App.Border}" Margin="6,5,6,5" />
                            <ListBox Style="{StaticResource NavList}"
                                     ItemsSource="{Binding SettingsItems}"
                                     ItemTemplate="{StaticResource NavigationItemTemplate}"
                                     SelectedItem="{Binding SelectedPage, Mode=TwoWay}" />
                        </StackPanel>

                        <ListBox Style="{StaticResource NavList}"
                                 ItemsSource="{Binding Pages}"
                                 ItemTemplate="{StaticResource NavigationItemTemplate}"
                                 SelectedItem="{Binding SelectedPage, Mode=TwoWay}" />
                    </DockPanel>
                </Border>

                <!-- Hosted Page View: the incoming page fades and lifts into place. -->
                <ContentControl x:Name="PageHost" Grid.Column="1" Content="{Binding CurrentPage}">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="PageSlide" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>

            <!-- ======================= Command Palette Overlay ======================= -->
            <Grid x:Name="PaletteOverlay" Grid.RowSpan="2"
                  Background="#99000000"
                  Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVisibility}}">
                <Border x:Name="PalettePanel" Width="420" MaxHeight="380"
                        VerticalAlignment="Top" Margin="0,48,0,0"
                        RenderTransformOrigin="0.5,0.2"
                        Background="{DynamicResource App.CardBackground}"
                        BorderBrush="{DynamicResource App.Gold}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="PaletteScale" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PaletteQuery"
                                     Text="{Binding CommandPaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" Padding="8,6"
                                     AutomationProperties.Name="Command palette search" />
                            <Button Grid.Column="1" Content="&#x2715;" Style="{StaticResource PillButton}"
                                    Margin="6,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding CloseCommandPaletteCommand}" />
                        </Grid>

                        <ListBox x:Name="PaletteList"
                                 ItemsSource="{Binding FilteredCommands}"
                                 MaxHeight="260"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 AutomationProperties.Name="Command palette results">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Margin="0,2" CornerRadius="4"
                                            Background="{DynamicResource App.RowBackground}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Category}" Style="{StaticResource CaptionText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Shortcut}" Style="{StaticResource CaptionText}"
                                                       VerticalAlignment="Center" Margin="8,0" />
                                            <Button Grid.Column="2" Content="Go" Style="{StaticResource PillButton}"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.ExecutePaletteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <TextBlock Text="&#x2191; &#x2193; to move  ·  Enter to run  ·  Esc to close"
                                   FontSize="9" Foreground="{DynamicResource App.Subtle}"
                                   Margin="2,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
