<views:FpmWindow x:Class="PCManager.Views.IconGalleryWindow"
        xmlns:views="clr-namespace:PCManager.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PCManager.Controls"
        Title="Icon3D gallery"
        Width="1120" Height="820"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource App.Card}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,0,0,1">
            <StackPanel Margin="{StaticResource Thickness.4}">
                <TextBlock Text="Icon3D inventory" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="Summary"
                           Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource Thickness.2}" />
                <StackPanel Orientation="Horizontal" Margin="{StaticResource Thickness.2}">
                    <Button Content="Light" Style="{StaticResource SecondaryButton}"
                            Click="Light_Click" Margin="{StaticResource Thickness.2}" />
                    <Button Content="Dark" Style="{StaticResource SecondaryButton}"
                            Click="Dark_Click" Margin="{StaticResource Thickness.2}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="{StaticResource Thickness.2}">
                    <controls:Icon3D Key="Boost" Size="40" Tint="Gold" Animated="True" Margin="{StaticResource Thickness.2}" />
                    <controls:Icon3D Key="Boost" Size="40" Tint="Neutral" Animated="True" Margin="{StaticResource Thickness.2}" />
                    <controls:Icon3D Key="Boost" Size="40" Tint="Success" Animated="True" Margin="{StaticResource Thickness.2}" />
                    <controls:Icon3D Key="Boost" Size="40" Tint="Warning" Animated="True" Margin="{StaticResource Thickness.2}" />
                    <controls:Icon3D Key="Boost" Size="40" Tint="Critical" Animated="True" Margin="{StaticResource Thickness.2}" />
                    <TextBlock Text="Gold · Neutral · Success · Warning · Critical"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Thickness.2}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="{StaticResource Thickness.4}">
            <ItemsControl x:Name="CategoryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="{StaticResource Thickness.3}">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding Icons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="188"
                                                Background="{DynamicResource App.Card}"
                                                BorderBrush="{DynamicResource App.Border}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Radius.Card}"
                                                Padding="{StaticResource Thickness.3}"
                                                Margin="{StaticResource Thickness.2}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:Icon3D Key="{Binding}" Size="20" Animated="True" Margin="{StaticResource Thickness.1}" />
                                                    <controls:Icon3D Key="{Binding}" Size="32" Animated="True" Margin="{StaticResource Thickness.1}" />
                                                    <controls:Icon3D Key="{Binding}" Size="24" Tint="Neutral" Margin="{StaticResource Thickness.1}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:Icon3D Key="{Binding}" Size="56" Animated="True" Margin="{StaticResource Thickness.1}" />
                                                    <controls:Icon3D Key="{Binding}" Size="96" Animated="True" Margin="{StaticResource Thickness.1}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="{StaticResource Thickness.1}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</views:FpmWindow>
