<Window x:Class="PCManager.Views.FloatingToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Farmanullah PC Manager Toolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Border Background="{DynamicResource App.Card}"
            BorderBrush="{DynamicResource App.Border}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="14,8"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.22" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="{DynamicResource Icon.Logo}" Fill="{DynamicResource App.Accent}"
                  Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />

            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding LoadText}" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource App.Accent}" />
                <TextBlock Text="{Binding FreeText}" Style="{StaticResource CaptionText}" FontSize="10" />
            </StackPanel>

            <Border Width="1" Height="26" Background="{DynamicResource App.Border}" Margin="12,0" />

            <Button Content="Boost" Style="{StaticResource PillButton}" Margin="0,0,6,0"
                    Command="{Binding BoostCommand}" ToolTip="Trim memory now" />
            <Button Content="Shot" Style="{StaticResource PillButton}" Margin="0,0,6,0"
                    Command="{Binding ScreenshotCommand}" ToolTip="Screenshot" />
            <Button Content="Note" Style="{StaticResource PillButton}" Margin="0,0,6,0"
                    Command="{Binding NotepadCommand}" ToolTip="Notepad" />
            <Button Content="Calc" Style="{StaticResource PillButton}" Margin="0,0,6,0"
                    Command="{Binding CalculatorCommand}" ToolTip="Calculator" />

            <Button Content="✕" Style="{StaticResource CaptionButton}" Width="30" Height="26"
                    Click="Close_Click" ToolTip="Hide toolbar" />
        </StackPanel>
    </Border>
</Window>
