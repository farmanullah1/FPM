<views:FpmWindow x:Class="PCManager.Views.ExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PCManager.Views"
        Title="Exit FPM"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        CanMaximize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <StackPanel Margin="{StaticResource Thickness.5}">
        <TextBlock Text="Exit FPM?" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="{StaticResource Thickness.2}"
                   Text="The floating toolbar can keep running after the main window closes, so Boost and the tools stay one click away." />

        <Button Content="Exit everything" Margin="{StaticResource Thickness.2}" Padding="{StaticResource Thickness.3}"
                Click="ExitAll_Click" />
        <Button Content="Exit but keep the toolbar" Margin="{StaticResource Thickness.2}" Padding="{StaticResource Thickness.3}"
                Click="KeepToolbar_Click" />
        <Button Content="Cancel" Margin="{StaticResource Thickness.2}" Padding="{StaticResource Thickness.3}"
                Click="Cancel_Click" />

        <CheckBox x:Name="RememberChoice" Content="Remember my choice" Margin="{StaticResource Thickness.2}"
                  AutomationProperties.Name="Remember my choice" />
    </StackPanel>
</views:FpmWindow>
