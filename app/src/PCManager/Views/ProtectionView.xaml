<UserControl x:Class="PCManager.Views.ProtectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCManager.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10,12,14">
        <Grid MaxWidth="{StaticResource App.ContentMaxWidth}" HorizontalAlignment="Stretch">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0" Orientation="Horizontal">
                    <controls:Icon3D Key="Protection" Size="44" Margin="{StaticResource Thickness.3}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Protection" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="Security status, Windows Update and the tools that keep Windows settings intact." />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon3D Key="Restore" Size="14" Margin="{StaticResource Thickness.1}" />
                        <TextBlock Text="Refresh status" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Status banner -->
            <Border Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="44" Height="44" CornerRadius="22"
                            Background="{Binding BannerHealthy, Converter={StaticResource HealthyToBrush}}"
                            Opacity="0.15" VerticalAlignment="Center" />
                    <controls:Icon3D Grid.Column="0" Key="Shield" Size="28"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Animated="True" />

                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BannerTitle}" FontSize="17" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BannerDetail}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Center" Command="{Binding CheckUpdatesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon3D Key="WindowsUpdate" Size="14" Margin="{StaticResource Thickness.1}" />
                            <TextBlock Text="Check for updates" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Margin="0,6,0,0">
                <TextBlock Text="Security details" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
            </Grid>

            <UniformGrid Columns="2" Margin="0,0,0,4">
                <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D Key="VirusScan" Size="22" Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="Windows Defender" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="Quick Scan" Style="{StaticResource PillButton}"
                                    HorizontalAlignment="Right" Command="{Binding StartQuickScanCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding DefenderDetail}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon3D Key="WindowsUpdate" Size="22" Margin="{StaticResource Thickness.1}" />
                            <TextBlock Text="Windows Update" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateDetail}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Protection tools" Style="{StaticResource SectionTitle}" Margin="0,8,0,10" />

            <UniformGrid Columns="2">
                <Button Style="{StaticResource ActionCard}" Command="{Binding PopupCommand}">
                    <StackPanel>
                        <controls:Icon3D Key="Popup" Size="26" HorizontalAlignment="Left" Animated="True" />
                        <TextBlock Text="Notification settings" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <TextBlock Text="Open the Windows notification page for per-app controls." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionCard}" Command="{Binding BrowserCommand}">
                    <StackPanel>
                        <controls:Icon3D Key="Browser" Size="26" HorizontalAlignment="Left" Animated="True" />
                        <TextBlock Text="Default browser protection" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <TextBlock Style="{StaticResource CaptionText}">
                            <Run Text="Current browser: " /><Run Text="{Binding BrowserName, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionCard}" Command="{Binding TaskbarCommand}">
                    <StackPanel>
                        <controls:Icon3D Key="Taskbar" Size="26" HorizontalAlignment="Left" Animated="True" />
                        <TextBlock Text="Taskbar repair" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <TextBlock Text="Restart Explorer to rebuild a frozen taskbar." Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionCard}" Command="{Binding RestoreAppsCommand}">
                    <StackPanel>
                        <controls:Icon3D Key="DefaultApps" Size="26" HorizontalAlignment="Left" Animated="True" />
                        <TextBlock Text="Restore default apps" FontWeight="SemiBold" Margin="0,10,0,2" />
                        <TextBlock Text="Reset file and link handlers to your preferred apps." Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Pop-up management: visible-window monitor + reversible hosts block -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Pop-up management" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="Lists apps that own visible windows. FPM never closes or blocks another app's window; Windows has no supported generic pop-up blocker. Use the Windows notification page or the hosts block below." />
                        </StackPanel>
                        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Scan open windows" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0" Command="{Binding ScanPopupsCommand}" />
                            <Button Content="Notification settings" Style="{StaticResource PillButton}"
                                    Command="{Binding PopupCommand}" />
                        </WrapPanel>
                    </Grid>

                    <TextBlock Text="{Binding PopupSummary}" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Margin="0,10,0,6" />

                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasPopupResults, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding PopupSources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource CaptionText}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding WindowTitle}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SeenLabel}"
                                                       Style="{StaticResource CaptionText}"
                                                       VerticalAlignment="Center" Margin="10,0" />
                                            <Button Grid.Column="2" Content="Allow" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.TogglePopupAllowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PillButton}">
                                                        <Setter Property="ToolTip" Value="Ignore this app in future scans" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAllowed}" Value="True">
                                                                <Setter Property="Content" Value="Allowed" />
                                                                <Setter Property="ToolTip" Value="Click to revoke this exception" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Allow list + local sighting history -->
                    <Border Padding="12" Margin="0,8,0,0"
                            Background="{DynamicResource App.Background}"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Allowed apps" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Clear sighting history"
                                        Style="{StaticResource PillButton}"
                                        ToolTip="Delete the local 30-day sighting counts"
                                        Command="{Binding ClearPopupHistoryCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Allow is permanent until you revoke it here, even while the app is closed. Sightings are counted locally in %LOCALAPPDATA%\FPM\popup-history.json and expire after 30 days." />

                            <TextBlock Text="No apps are allowed yet."
                                       Style="{StaticResource CaptionText}"
                                       Visibility="{Binding HasAllowedPopups, Converter={StaticResource InverseBoolToVisibility}}" />

                            <ItemsControl ItemsSource="{Binding AllowedPopups}"
                                          Visibility="{Binding HasAllowedPopups, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Revoke"
                                                    Style="{StaticResource PillButton}"
                                                    ToolTip="Stop ignoring this app on future scans"
                                                    Command="{Binding DataContext.RevokePopupAllowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource App.AccentSoft}" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Hosts block (administrator)" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,6"
                                       Text="Writes a blocker section between # BEGIN FPM and # END FPM. The elevated helper saves a timestamped hosts backup in %LOCALAPPDATA%\FPM\backups first, and Remove restores the file without that section." />
                            <TextBox Text="{Binding HostsBlockInput, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" VerticalContentAlignment="Center"
                                     ToolTip="Comma- or newline-separated domains, e.g. ads.example.com" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Block domains" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ApplyHostsBlockCommand}" Margin="0,0,6,4" />
                                <Button Content="Remove block" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding RemoveHostsBlockCommand}" Margin="0,0,0,4" />
                            </WrapPanel>
                            <TextBlock Text="{Binding HostsBlockStatus}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Network Diagnostics & Connectivity -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Network Diagnostics &amp; Latency" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Test connectivity to default gateway, DNS, and public internet endpoints."
                                       Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="Test Network" Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,8,0" Command="{Binding RunNetworkDiagnosticsCommand}" />
                            <Button Content="Flush DNS" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding FlushDnsCommand}" />
                        </WrapPanel>
                    </Grid>

                    <TextBlock Text="{Binding NetworkSummary}" Style="{StaticResource CaptionText}" Margin="0,10,0,6" TextWrapping="Wrap" />

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SpeedTestEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Absolute http(s) URL that returns bytes for the download test" />
                        <Button Grid.Column="1" Content="Speed test" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Command="{Binding RunSpeedTestCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding SpeedTestResultText}" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />

                    <!-- Active Adapter Card -->
                    <Border Visibility="{Binding HasNetworkDiagResult, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource RowCard}" Padding="12" Margin="0,6,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Active Adapter:" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding ActiveAdapter.Name}" FontWeight="SemiBold" Margin="0,1,0,6" />
                                <TextBlock Text="IPv4 Address:" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding ActiveAdapter.IPv4Address}" FontWeight="SemiBold" Margin="0,1,0,6" />
                                <TextBlock Text="Default Gateway:" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding ActiveAdapter.Gateway}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Link Speed:" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding ActiveAdapter.LinkSpeed}" FontWeight="SemiBold" Margin="0,1,0,6" />
                                <TextBlock Text="DNS Servers:" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding ActiveAdapter.DnsServers}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,1,0,6" />
                                <TextBlock Text="Adapter Model:" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding ActiveAdapter.Description}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Ping Latency Results -->
                    <ItemsControl ItemsSource="{Binding PingResults}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding HostOrIp}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource App.Success}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource App.Warning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />

        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
