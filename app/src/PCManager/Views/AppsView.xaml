<UserControl x:Class="PCManager.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,28,28">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Apps" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="Running applications, what starts with Windows, and everything installed on this PC." />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" Command="{Binding RefreshCommand}" />
            </Grid>

            <!-- Process management -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Process management" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProcessSummary}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RunningApps}" Margin="0,12,0,0"
                                  Style="{StaticResource CardList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PidText}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CpuText}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" Margin="12,0" MinWidth="52" />
                                        <TextBlock Grid.Column="2" Text="{Binding MemoryText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" MinWidth="80" />
                                        <Button Grid.Column="3" Content="End" Style="{StaticResource PillButton}"
                                                Margin="12,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding EndCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Startup apps -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Startup apps" FontSize="17" FontWeight="SemiBold" />
                        <Button Content="Reload" Style="{StaticResource PillButton}"
                                HorizontalAlignment="Right" Command="{Binding RefreshStartupCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                               Text="Read from HKCU/HKLM Run, the Startup folders and Task Scheduler." />

                    <ItemsControl ItemsSource="{Binding StartupApps}" Margin="0,12,0,0"
                                  Style="{StaticResource CardList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Command}" Style="{StaticResource CaptionText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SourceText}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" Margin="12,0" />
                                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanToggle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- App management -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="App management" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding InstalledSummary}" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding AppSearch, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search installed apps" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding InstalledApps}" Style="{StaticResource CardList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding VersionText}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" Margin="12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" MinWidth="70" />
                                        <Button Grid.Column="3" Content="Uninstall" Style="{StaticResource PillButton}"
                                                Margin="12,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding UninstallCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Store/MSIX apps -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Microsoft Store apps" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StoreAppsSummary}" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                               Text="MSIX packages for this account. Framework, resource and system packages are hidden; Microsoft PC Manager is never removed by this app." />

                    <ItemsControl ItemsSource="{Binding StoreApps}" Style="{StaticResource CardList}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,6"
                                        ToolTip="{Binding PackageFullName}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Uninstall" Style="{StaticResource PillButton}"
                                                Margin="12,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding UninstallCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
