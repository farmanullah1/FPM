<UserControl x:Class="PCManager.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:PCManager.Core.Models;assembly=PCManager.Core">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10,12,14">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Storage" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="Measure first, approve a plan, then clean. Every size comes from a real scan." />
                </StackPanel>
                <Button Grid.Column="1" Content="Rescan" Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" Command="{Binding ScanCleanupCommand}" />
            </Grid>

            <!-- System drive -->
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="System drive" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding SystemDriveName}" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Style="{StaticResource ThinProgress}" Height="10" Margin="0,10,0,8"
                                 Value="{Binding DriveUsedPercent, Mode=OneWay}" />
                    <Grid>
                        <TextBlock Text="{Binding DriveUsedText}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding DriveFreeText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding DriveSummary}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Cleanup Center: phase 1 scan, phase 2 approval -->
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Cleanup Center" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="The scan only measures. Tick rows or type an approval command; deletion starts after you confirm." />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Clean Everything" Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,8,0"
                                    Command="{Binding ScanCleanupCommand}"
                                    ToolTip="Full consolidated scan across all supported categories" />
                            <Button Content="Quick Scan" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ScanCleanupCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding CleanupSummary}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CleanupTotalText}" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CleanupNotesText}" Style="{StaticResource CaptionText}" Margin="0,4,0,8" />

                    <TextBlock Text="Profiles (they only tick rows; approval is still required)"
                               Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding CleanupProfiles}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" ToolTip="{Binding Hint}"
                                        Style="{StaticResource PillButton}" Margin="0,0,6,6"
                                        Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Id}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding CleanupItems}" Style="{StaticResource CardList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding NumberText}" FontWeight="SemiBold"
                                                           Margin="7,1,0,0" VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Margin="7,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding PathText}" Style="{StaticResource CaptionText}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding PathText}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SafetyText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding TierText}" FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource App.Success}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tier}" Value="{x:Static core:CleanupTier.Caution}">
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Warning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tier}" Value="{x:Static core:CleanupTier.OptIn}">
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Critical}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource CaptionText}"
                                                       HorizontalAlignment="Right" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Approval gate -->
                    <Border Background="{DynamicResource App.AccentSoft}" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Approval gate" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ApprovalHint}" Style="{StaticResource CaptionText}" Margin="0,2,0,8" />

                                                            <StackPanel>
                                    <TextBox Text="{Binding ApprovalCommand, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="proceed | only 1, 2 | keep 1, 2" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="Review command" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding ReviewApprovalCommand}" Margin="0,0,6,4" />
                                        <Button Content="Review ticked rows" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding ReviewSelectedCommand}" Margin="0,0,0,4" />
                                    </WrapPanel>
                                </StackPanel>

                            <TextBlock Text="{Binding ApprovalReviewText}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />

                            <StackPanel Visibility="{Binding HasPendingPlan, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,8,0,0">
                                <CheckBox Content="Create a System Restore point first (administrator approval)"
                                          IsChecked="{Binding CreateRestorePoint, Mode=TwoWay}" Margin="0,0,0,2" />
                                <TextBlock Text="Windows may skip it if a restore point was created in the last 24 hours; the report states what happened. Ignored for dry runs."
                                           Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                                <CheckBox Content="Move eligible files to quarantine instead of deleting them"
                                          IsChecked="{Binding QuarantineEnabled, Mode=TwoWay}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding QuarantinePolicyText}"
                                           Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                                <CheckBox Content="Dry run (record what would be removed, delete nothing)"
                                          IsChecked="{Binding IsDryRun, Mode=TwoWay}" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Confirm and clean" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ExecutePlanCommand}" />
                                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding CancelPlanCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Last report -->
                    <Border Visibility="{Binding HasCleanupReport, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource RowCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel>
                                <TextBlock Text="Last cleanup report" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="Export Markdown" Style="{StaticResource PillButton}"
                                            Command="{Binding ExportMarkdownCommand}" Margin="0,0,6,4" />
                                    <Button Content="Export CSV" Style="{StaticResource PillButton}"
                                            Command="{Binding ExportCsvCommand}" Margin="0,0,6,4" />
                                    <Button Content="Open log folder" Style="{StaticResource PillButton}"
                                            Command="{Binding OpenCleanupLogCommand}" Margin="0,0,0,4" />
                                </WrapPanel>
                            </StackPanel>
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                <TextBlock Text="{Binding CleanupReportText}" Style="{StaticResource CaptionText}" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Cleanup history -->
            <Border Visibility="{Binding HasCleanupHistory, Converter={StaticResource BoolToVisibility}}"
                    Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="Cleanup history" FontSize="14" FontWeight="SemiBold" />
                        <Button Content="Open reports folder" Style="{StaticResource PillButton}"
                                HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding OpenReportsCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding CleanupHistoryText}" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Quarantine -->
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="Quarantine" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding QuarantineSummary}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" />
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="Open folder" Style="{StaticResource PillButton}"
                                    Command="{Binding OpenQuarantineFolderCommand}" Margin="0,0,6,4" />
                            <Button Content="Delete quarantined files" Style="{StaticResource PillButton}"
                                    Command="{Binding PurgeQuarantineCommand}" Margin="0,0,0,4" />
                        </WrapPanel>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding QuarantineEntries}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding OriginalPath}" Style="{StaticResource CaptionText}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalPath}" />
                                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="12,0" />
                                        <Button Grid.Column="2" Content="Restore" Style="{StaticResource PillButton}"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.RestoreQuarantineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Restore refuses to overwrite: if the original path is occupied it does nothing. The quarantine lives in this app's own data folder and is not a backup." />
                </StackPanel>
            </Border>

            <!-- Large files -->
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Manage large files" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Scan a folder or drive and filter by size."
                               Style="{StaticResource CaptionText}" Margin="0,2,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Folder to scan" />
                        <Button Grid.Column="1" Content="Open folder" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Command="{Binding OpenScanFolderCommand}" />
                    </Grid>

                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="&gt; 10 MB" Style="{StaticResource PillButton}"
                                Command="{Binding FilterLargeFilesCommand}" CommandParameter="10" Margin="0,0,6,4" />
                        <Button Content="&gt; 50 MB" Style="{StaticResource PillButton}"
                                Command="{Binding FilterLargeFilesCommand}" CommandParameter="50" Margin="0,0,6,4" />
                        <Button Content="&gt; 100 MB" Style="{StaticResource PillButton}"
                                Command="{Binding FilterLargeFilesCommand}" CommandParameter="100" Margin="0,0,6,4" />
                        <Button Content="&gt; 500 MB" Style="{StaticResource PillButton}"
                                Command="{Binding FilterLargeFilesCommand}" CommandParameter="500" Margin="0,0,6,4" />
                        <Button Content="&gt; 1 GB" Style="{StaticResource PillButton}"
                                Command="{Binding FilterLargeFilesCommand}" CommandParameter="1024" Margin="0,0,6,4" />
                        <TextBlock Text="{Binding LargeFileFilterText}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Margin="0,0,0,4" />
                    </WrapPanel>

                    <TextBlock Text="{Binding LargeFileSummary}" Style="{StaticResource CaptionText}" Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding LargeFiles}" MaxHeight="260">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Duplicates -->
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="Duplicate files" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DuplicateSummary}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="Full SHA-256 check. The oldest copy is kept; extras go to the Recycle Bin, never permanent delete." />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Open Recycle Bin" Style="{StaticResource PillButton}"
                                    Command="{Binding OpenRecycleBinCommand}" Margin="0,0,6,4" />
                            <Button Content="Find duplicates" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding FindDuplicatesCommand}" Margin="0,0,0,4" />
                        </WrapPanel>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding DuplicateGroups}" Margin="0,12,0,0" MaxHeight="240">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding KeepText}" Style="{StaticResource CaptionText}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding KeepPath}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" Margin="12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding WasteText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Grid.Column="3" Content="Recycle extras" Style="{StaticResource PillButton}"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.RecycleDuplicateExtrasCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Storage Sense -->
            <Border Style="{StaticResource Card}" Padding="12">
                                    <StackPanel>
                        <TextBlock Text="Storage Sense" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Text="Lets Windows remove temporary files and empty the recycle bin automatically." />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Enable Storage Sense"
                                  HorizontalAlignment="Left" Margin="0,6,0,0"
                                  IsChecked="{Binding StorageSenseEnabled, Mode=TwoWay}" />
                    </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
