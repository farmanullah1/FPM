<UserControl x:Class="PCManager.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:PCManager.Core.Models;assembly=PCManager.Core">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,28,28">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Storage" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="Measure first, approve a plan, then clean. Every size comes from a real scan." />
                </StackPanel>
                <Button Grid.Column="1" Content="Rescan" Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" Command="{Binding ScanCleanupCommand}" />
            </Grid>

            <!-- System drive -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="System drive" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding SystemDriveName}" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Style="{StaticResource ThinProgress}" Height="10" Margin="0,10,0,8"
                                 Value="{Binding DriveUsedPercent, Mode=OneWay}" />
                    <Grid>
                        <TextBlock Text="{Binding DriveUsedText}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding DriveFreeText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding DriveSummary}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Cleanup Center: phase 1 scan, phase 2 approval -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Cleanup Center" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CaptionText}"
                                       Text="The scan only measures. Tick rows or type an approval command; deletion starts after you confirm." />
                        </StackPanel>
                        <Button Content="Scan cleanup targets" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding ScanCleanupCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding CleanupSummary}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CleanupTotalText}" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CleanupNotesText}" Style="{StaticResource CaptionText}" Margin="0,4,0,8" />

                    <ItemsControl ItemsSource="{Binding CleanupItems}" Style="{StaticResource CardList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,0,0" />

                                        <TextBlock Grid.Column="1" Text="{Binding NumberText}" FontWeight="SemiBold"
                                                   Margin="12,1,10,0" VerticalAlignment="Top" />

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PathText}" Style="{StaticResource CaptionText}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}" />
                                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding SafetyText}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="12,0,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding TierText}" FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource App.Success}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tier}" Value="{x:Static core:CleanupTier.Caution}">
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Warning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tier}" Value="{x:Static core:CleanupTier.OptIn}">
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Critical}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource CaptionText}"
                                                       HorizontalAlignment="Right" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Approval gate -->
                    <Border Background="{DynamicResource App.AccentSoft}" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Approval gate" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ApprovalHint}" Style="{StaticResource CaptionText}" Margin="0,2,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ApprovalCommand, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="proceed | only 1, 2 | keep 1, 2" />
                                <Button Grid.Column="1" Content="Review command" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" Command="{Binding ReviewApprovalCommand}" />
                                <Button Grid.Column="2" Content="Review ticked rows" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Command="{Binding ReviewSelectedCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding ApprovalReviewText}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />

                            <StackPanel Visibility="{Binding HasPendingPlan, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,8,0,0">
                                <CheckBox Content="Create a System Restore point first (administrator approval)"
                                          IsChecked="{Binding CreateRestorePoint, Mode=TwoWay}" Margin="0,0,0,2" />
                                <TextBlock Text="Windows may skip it if a restore point was created in the last 24 hours; the report states what happened. Ignored for dry runs."
                                           Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                                <CheckBox Content="Dry run (record what would be removed, delete nothing)"
                                          IsChecked="{Binding IsDryRun, Mode=TwoWay}" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Confirm and clean" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ExecutePlanCommand}" />
                                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding CancelPlanCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Last report -->
                    <Border Visibility="{Binding HasCleanupReport, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource RowCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Last cleanup report" FontWeight="SemiBold" />
                                <Button Content="Open log folder" Style="{StaticResource PillButton}"
                                        HorizontalAlignment="Right" Command="{Binding OpenCleanupLogCommand}" />
                            </Grid>
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                <TextBlock Text="{Binding CleanupReportText}" Style="{StaticResource CaptionText}" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Large files -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Manage large files" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Scan a folder or drive and filter by size."
                               Style="{StaticResource CaptionText}" Margin="0,2,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Folder to scan" />
                        <Button Grid.Column="1" Content="Open folder" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Command="{Binding OpenScanFolderCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="&gt; 10 MB" Style="{StaticResource PillButton}"
                                Command="{Binding FilterLargeFilesCommand}" CommandParameter="10" Margin="0,0,8,0" />
                        <Button Content="&gt; 50 MB" Style="{StaticResource PillButton}"
                                Command="{Binding FilterLargeFilesCommand}" CommandParameter="50" Margin="0,0,8,0" />
                        <Button Content="&gt; 100 MB" Style="{StaticResource PillButton}"
                                Command="{Binding FilterLargeFilesCommand}" CommandParameter="100" Margin="0,0,8,0" />
                        <Button Content="&gt; 500 MB" Style="{StaticResource PillButton}"
                                Command="{Binding FilterLargeFilesCommand}" CommandParameter="500" Margin="0,0,8,0" />
                        <Button Content="&gt; 1 GB" Style="{StaticResource PillButton}"
                                Command="{Binding FilterLargeFilesCommand}" CommandParameter="1024" />
                        <TextBlock Text="{Binding LargeFileFilterText}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding LargeFileSummary}" Style="{StaticResource CaptionText}" Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding LargeFiles}" MaxHeight="260">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Duplicates -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Duplicate files" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DuplicateSummary}" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <Button Content="Find duplicates" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding FindDuplicatesCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding DuplicateGroups}" Margin="0,12,0,0" MaxHeight="240">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Paths[0]}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" Margin="12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding WasteText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Storage Sense -->
            <Border Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Storage Sense" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="Lets Windows remove temporary files and empty the recycle bin automatically." />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Enable Storage Sense"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsChecked="{Binding StorageSenseEnabled, Mode=TwoWay}" />
                </Grid>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
