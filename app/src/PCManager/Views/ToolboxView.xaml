<UserControl x:Class="PCManager.Views.ToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,28,28">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Toolbox" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="Everyday utilities plus the floating toolbar for quick access from anywhere." />
                </StackPanel>
            </Grid>

            <!-- Floating toolbar -->
            <Border Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Data="{DynamicResource Icon.Pill}" Fill="{DynamicResource App.Accent}"
                          Width="30" Height="30" Stretch="Uniform" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="Show floating toolbar" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="A small always-on-top pill with live RAM, one-click Boost, screenshot, Notepad and Calculator. Drag it anywhere." />
                    </StackPanel>

                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              IsChecked="{Binding ShowFloatingToolbar, Mode=TwoWay}" />
                </Grid>
            </Border>

            <TextBlock Text="Tools" Style="{StaticResource SectionTitle}" Margin="0,6,0,10" />

            <ItemsControl ItemsSource="{Binding Tools}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ActionCard}"
                                Command="{Binding DataContext.LaunchToolCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Id}">
                            <StackPanel>
                                <Path Data="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                                      Fill="{DynamicResource App.Accent}" Width="24" Height="24"
                                      Stretch="Uniform" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,10,0,2" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
